.page { min-height: 100vh; padding: 22px 18px 40px; color:#171716; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif; }
.topbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:34px; }.brand { display:flex; align-items:center; gap:9px; font-size:17px; font-weight:600; }.brand-mark { display:flex; align-items:center; justify-content:center; width:27px; height:27px; border:1px solid #171716; border-radius:50%; font-size:22px; line-height:14px; }.status,.tiny,.label,.hint,.footer,.eyebrow { color:#8e8d86; font-size:10px; letter-spacing:.08em; }.eyebrow { display:block; margin-bottom:10px; text-transform:uppercase; }.hero { position:relative; display:flex; flex-direction:column; justify-content:flex-end; min-height:330px; padding:30px 22px; margin-bottom:16px; overflow:hidden; color:#f5f4ef; background:#20201e; border-radius:15px; }.hero.running { background:#252b21; }.hero:after { content:""; position:absolute; top:-100px; right:-115px; width:270px; height:270px; border:1px solid rgba(199,243,108,.25); border-radius:50%; }.orbit { position:absolute; right:-16px; bottom:55px; width:150px; height:150px; border:1px solid rgba(255,255,255,.12); border-radius:50%; }.time { display:none; }.time.actual { display:block; position:relative; z-index:1; margin-bottom:8px; font-family:monospace; font-size:58px; letter-spacing:-.08em; }.caption { position:relative; z-index:1; margin-bottom:24px; color:#aaa9a2; font-size:12px; }.cta { position:relative; z-index:2; width:100%; padding:14px 16px; border:0; border-radius:6px; background:#c7f36c; color:#20201e; font-size:12px; font-weight:600; text-align:left; }.cta text { float:right; font-size:18px; line-height:12px; }.cta.stop { background:#ecebe4; }.card { padding:22px 20px; margin-bottom:16px; border:1px solid #deddd6; border-radius:13px; background:#fbfaf6; }.section-head { display:flex; justify-content:space-between; gap:12px; }.title { display:block; margin:7px 0 24px; font-size:27px; line-height:1.2; letter-spacing:-.06em; }.muted { color:#9b9b93; }.stats { display:flex; justify-content:space-between; padding:18px 0 20px; border-top:1px solid #deddd6; }.stats view { display:flex; flex-direction:column; gap:6px; }.number { font-size:18px; }.label { font-size:9px; letter-spacing:0; }.link { padding:0; border:0; background:transparent; font-family:monospace; font-size:10px; text-align:left; }.subtitle { display:block; font-size:17px; font-weight:500; }.grid { display:grid; grid-template-columns:repeat(7,1fr); gap:6px; padding:28px 0 20px; }.cell { width:100%; aspect-ratio:1; border-radius:3px; background:#ebeae3; }.cell.level-1 { background:#dbe9b4; }.cell.level-2 { background:#a3d35c; }.cell.empty { background:#f1f0eb; }.hint { font-size:9px; letter-spacing:0; }.footer { padding-top:6px; text-align:center; font-size:9px; }.mask { position:fixed; inset:0; display:flex; align-items:flex-end; background:rgba(24,24,22,.35); }.sheet { width:100%; padding:24px 20px 32px; border-radius:15px 15px 0 0; background:#fbfaf6; }.handle { width:34px; height:3px; margin:0 auto 22px; border-radius:4px; background:#deddd6; }.sheet-title { display:block; margin:8px 0; font-size:28px; letter-spacing:-.06em; }.sheet-copy { display:block; margin-bottom:22px; color:#8e8d86; font-size:12px; }.categories { display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin-bottom:20px; }.category { padding:11px 8px; border:1px solid #deddd6; border-radius:6px; background:transparent; font-size:11px; }.category.chosen { border-color:#9dcb57; background:#edf6dc; }.cta.dark { background:#20201e; color:#f5f4ef; }
